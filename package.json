{
  "name": "tangmen-aigc-workbench",
  "version": "0.1.2",
  "private": true,
  "description": "Tangmen AI creative workbench: chat, canvas and director stage.",
  "license": "MIT",
  "author": "zhangtuo",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "setup:runtime": "node node_modules/electron/install.js",
    "predev": "npm run setup:runtime",
    "dev": "vite --mode student",
    "build": "vite build --mode student",
    "preview": "vite preview",
    "pretest": "npm run setup:runtime && vite build --mode=test",
    "test": "vitest run",
    "test:e2e": "npm run pretest && playwright test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "migrate:projects": "node scripts/migrate-projects.mjs",
    "package:windows": "vite build --mode student && node scripts/build-student-release.mjs",
    "audit:source": "node scripts/audit-public-source.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.82",
    "@anthropic-ai/claude-agent-sdk": "^0.3.214",
    "@anthropic-ai/sdk": "^0.112.3",
    "@excalidraw/excalidraw": "^0.18.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/codex-sdk": "^0.153.4",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@xyflow/react": "^12.11.2",
    "ai": "7.0.159",
    "chokidar": "^4.0.0",
    "electron-log": "^5.4.0",
    "electron-updater": "^6.8.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "subtitle": "^4.2.0",
    "three": "^0.185.1",
    "uuid": "^11.1.0",
    "webm-muxer": "^5.1.4",
    "zod": "^4.4.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "^4.3.0",
    "tree-kill": "^1.2.2",
    "typescript": "^6.0.3",
    "vite": "^5.4.19",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^1.6.1"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.1.5"
  }
